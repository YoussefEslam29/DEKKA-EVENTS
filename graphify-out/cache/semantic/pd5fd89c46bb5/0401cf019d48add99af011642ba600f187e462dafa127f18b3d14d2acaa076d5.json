{"nodes": [{"id": "design_system_06_tone_of_voice", "label": "Design System \u2014 Tone of Voice", "file_type": "document", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_06_tone_of_voice_brand_voice", "label": "Warm/Communal Brand Voice", "file_type": "concept", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_06_tone_of_voice_name_meaning", "label": "'Dekka' = Bench Meaning", "file_type": "concept", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dekka (\u062f\u0643\u0629) means bench/seating platform, baked directly into copy like the sign-up hero line 'Take your place on the bench' so the brand name becomes an invitation rather than just a logo."}, {"id": "design_system_06_tone_of_voice_copy_examples", "label": "Shipped Copy Examples Table", "file_type": "concept", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_06_tone_of_voice_arabic_first_principle", "label": "Arabic-First Copywriting Principle", "file_type": "rationale", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arabic is drafted first as the primary voice, then an English line is written to carry the same warmth rather than a literal translation, since a flat literal translation of a warm Arabic line usually reads stiff in English."}, {"id": "design_system_06_tone_of_voice_warm_vs_plain_rule", "label": "Warm vs. Plain Copy Rule", "file_type": "concept", "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hero headlines, empty states, confirmations, and the About page stay warm/invitational; transactional copy (form labels, errors, admin/staff tool copy) stays plain and clear."}], "edges": [{"source": "design_system_06_tone_of_voice", "target": "design_system_02_typography_bilingual_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "weight": 1.0}, {"source": "design_system_06_tone_of_voice_name_meaning", "target": "design_system_06_tone_of_voice_copy_examples", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "weight": 1.0}, {"source": "design_system_06_tone_of_voice_arabic_first_principle", "target": "design_system_06_tone_of_voice_copy_examples", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/06-tone-of-voice.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
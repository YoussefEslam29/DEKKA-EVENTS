# --- Database -------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/dekka
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dekka?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public origin of the app. Only needed when it isn't inferred (e.g. behind a proxy).
AUTH_URL=http://localhost:3000

# Social sign-in. Leave a pair blank and that button is simply not rendered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- Roles ----------------------------------------------------------------
# Comma-separated. These emails are promoted on first sign-in; after that,
# roles live in the database.
ADMIN_EMAILS=
STAFF_EMAILS=

# --- Cafe details (safe to expose to the browser) -------------------------
# The real accounts/location are already baked into lib/site.ts as defaults,
# so all of these are optional — only set one here to override it.
NEXT_PUBLIC_CAFE_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_ADDRESS_AR=
NEXT_PUBLIC_ADDRESS_EN=
NEXT_PUBLIC_HOURS_AR=
NEXT_PUBLIC_HOURS_EN=
NEXT_PUBLIC_CAFE_PHONE=
NEXT_PUBLIC_CAFE_EMAIL=

# Apple sign-in. Requires a paid Apple Developer Program membership:
# a Services ID (AUTH_APPLE_ID) and a client secret JWT signed with your key.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Push notifications -----------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address browsers may show if a push endpoint provider needs to reach you
VAPID_SUBJECT=mailto:you@dekka.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Event report ("Show on PDF") -----------------------------------------
# One shared Google service account creates + refreshes each "happened"
# event's report Sheet and PDF (Admin_Event_PDF.md). Reuse the SAME Google
# Cloud project as "Sign in with Google": enable the Google Sheets API and
# Google Drive API on it, create a service account, download its JSON key.
# Then create a folder in the cafe's own Google Drive and share it with the
# service account's email as Editor — its id (from the folder URL) is
# GOOGLE_DRIVE_FOLDER_ID. Until all three are set the button returns a
# "not set up yet" message instead of generating.
#
# Either paste the whole downloaded key file as one line...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or set these two (the private key with literal \n for newlines):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# PDF rendering uses headless Chromium. On Vercel it uses the bundled
# @sparticuz/chromium automatically. For local `next dev` on Windows/macOS it
# drives your installed Chrome — override its path here only if it isn't at
# the usual location (same binary scripts/shoot.mjs uses).
LOCAL_CHROME_PATH=

# --- Database -------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/dekka
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dekka?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public origin of the app. Only needed when it isn't inferred (e.g. behind a proxy).
AUTH_URL=http://localhost:3000

# Social sign-in. Leave a pair blank and that button is simply not rendered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- Roles ----------------------------------------------------------------
# Comma-separated. These emails are promoted on first sign-in; after that,
# roles live in the database.
ADMIN_EMAILS=
STAFF_EMAILS=

# --- Cafe details (safe to expose to the browser) -------------------------
# The real accounts/location are already baked into lib/site.ts as defaults,
# so all of these are optional — only set one here to override it.
NEXT_PUBLIC_CAFE_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_ADDRESS_AR=
NEXT_PUBLIC_ADDRESS_EN=
NEXT_PUBLIC_HOURS_AR=
NEXT_PUBLIC_HOURS_EN=
NEXT_PUBLIC_CAFE_PHONE=
NEXT_PUBLIC_CAFE_EMAIL=

# Apple sign-in. Requires a paid Apple Developer Program membership:
# a Services ID (AUTH_APPLE_ID) and a client secret JWT signed with your key.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Error tracking (Sentry) --------------------------------------------------
# Leave every one of these blank and Sentry never initialises: no network calls, no
# quota used, the app builds and runs exactly as it does without an account. That is
# the intended state for local development -- don't put a DSN here just to have one.
# See PLAN/observability.md.
#
# The DSN is a write-only ingest key, not a secret, which is why it can be NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: server-side DSN. Falls back to the public one above; set it only to send
# server errors to a different Sentry project than browser errors.
SENTRY_DSN=
#
# Build-time only, for uploading sourcemaps. Without them the build still succeeds --
# production stack traces are just minified and much less useful.
SENTRY_ORG=
SENTRY_PROJECT=
# SECRET. Never rename this to NEXT_PUBLIC_*; it would ship to the browser.
SENTRY_AUTH_TOKEN=

# --- Image uploads ----------------------------------------------------------
# Leave blank for local development: uploads are written to public/uploads/events/
# and served statically, exactly as before.
#
# Set it on any host with an ephemeral or read-only filesystem (Vercel), or the
# uploaded posters and account photos vanish between requests. Create the store
# in the Vercel dashboard under Storage -> Create -> Blob; connecting it to the
# project injects this variable automatically, so you normally don't type it in
# by hand. See lib/storage.ts.
BLOB_READ_WRITE_TOKEN=

# --- Push notifications -----------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address browsers may show if a push endpoint provider needs to reach you
VAPID_SUBJECT=mailto:you@dekka.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Event analysis report ("Show Analysis Report") ----------------------
# The admin button builds the report as a PDF on demand and opens it in a new
# tab — nothing is stored, no Google account or cloud project involved.
# Rendering uses headless Chromium: on Vercel the bundled @sparticuz/chromium
# is used automatically; for local `next dev` on Windows/macOS it drives the
# Chrome already installed on the machine (same binary scripts/shoot.mjs
# uses). Set this only if that Chrome isn't at the usual location.
LOCAL_CHROME_PATH=

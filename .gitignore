# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# admin-uploaded images (dev-scale local storage — see developer-guide.md Known Gaps)
/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# agent worktrees
.claude/worktrees/

# credentials / keys -- belt and braces so a stray key can never be committed
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
id_ecdsa
.npmrc
.netrc
.htpasswd
secrets.json
service-account*.json

# scratch/debris
_to_delete/
